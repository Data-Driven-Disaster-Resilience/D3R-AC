{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "D3R-AC Agent Manifest",
  "type": "object",
  "required": ["version", "project", "bus", "agents"],
  "properties": {
    "version": { "type": "integer" },
    "project": { "type": "string" },
    "bus": {
      "type": "object",
      "required": ["transport", "channel_prefix"],
      "properties": {
        "transport": { "enum": ["file", "redis"] },
        "channel_prefix": { "type": "string" },
        "file": {
          "type": "object",
          "properties": { "dir": { "type": "string" } }
        },
        "redis": {
          "type": "object",
          "properties": { "url": { "type": "string" } }
        }
      }
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "runtime", "kind", "entrypoint"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "runtime": { "enum": ["python", "node"] },
          "kind": { "enum": ["data", "analysis", "coordination"] },
          "entrypoint": { "type": "string" },
          "description": { "type": "string" },
          "subscribes": { "type": "array", "items": { "type": "string" } },
          "publishes": { "type": "array", "items": { "type": "string" } },
          "config": { "type": "object" }
        }
      }
    }
  }
}
