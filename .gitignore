# Environment / secrets — never commit real values (see CONTRIBUTING.md
# and docs/deployment-guide.md's Security checklist).
.env
.env.*
!.env.example

# Dependencies
node_modules/

# TronBox build output (compiled artifacts, ABIs) — regenerate with
# `tronbox compile`, don't commit.
build/

# Hardhat test harness for contracts/tron (see contracts/tron/hardhat.config.js)
# — regenerate with `npx hardhat compile`, don't commit.
contracts/tron/artifacts/
contracts/tron/cache/

# Cargo build output for contracts/casper (see contracts/casper/README.md)
# — regenerate with `cargo build --release --target wasm32-unknown-unknown`.
contracts/casper/target/
# Staged .wasm build artifacts inside each *-tests package -- CI's own
# wasm-staging step (d3rac-ci.yml) populates these fresh from
# target/wasm32-unknown-unknown/ on every run; regenerate, don't commit.
contracts/casper/*-tests/wasm/
contracts/casper/**/target/
Cargo.lock.bak

# OS / editor cruft
.DS_Store
*.log
overhaul.patch
*.patch
